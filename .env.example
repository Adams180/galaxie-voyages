# Galaxie Voyages — environment variables
# Copy to .env.local for local dev, and set the same keys in Vercel for prod.
# NEVER commit real values. This file documents names only.

# --- Email (contact form + service-request forms + newsroom magic links) ---
# Resend API key (https://resend.com → API Keys). Starts with "re_".
RESEND_API_KEY=
# Optional: inbox that receives form submissions (defaults to ghfsarl@yahoo.com).
CONTACT_TO=
# Optional: verified sender (defaults to "Galaxie Voyages <onboarding@resend.dev>").
CONTACT_FROM=

# --- Shared storage (reviews, public news, newsroom auth sessions) ---
# Upstash Redis / Vercel KV REST credentials (Vercel → Storage, or Upstash console).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Equivalent names also accepted:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Legacy shared-token news admin (/[lang]/news/admin) ---
# Retained until the authenticated newsroom replacement is verified, then removed.
NEWS_ADMIN_TOKEN=

# --- Newsroom authentication (Auth.js v5 — Part B) ---
# Session/cookie signing secret. Generate with: npx auth secret  (or openssl rand -base64 33)
AUTH_SECRET=
# Invitation allowlist: the TWO authorized publisher e-mails, comma-separated.
# Leave EMPTY until management supplies the two approved identities — no account
# can be created or used while this is empty. Max 2 are honoured.
NEWS_PUBLISHER_EMAILS=

# --- Managed image storage for the newsroom (Part B, upcoming) ---
# Vercel Blob read/write token (Vercel → Storage → Blob). Used for managed
# article image uploads instead of unrestricted external URLs.
BLOB_READ_WRITE_TOKEN=
